@model AddGamesViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <vc:header></vc:header>
    <div>
        <div class="title">
            <h1>Voeg spellen toe</h1>
        </div> 
        <div class="d-flex justify-content-center align-items-center mt-4">
            <form class="addGamesForm" asp-action="AddGames" asp-controller="BoardGameNight" method="post">
                <div class="row">
                    <div class="mt-3 col-md-12">
                        <label asp-for="game.Name">Spelnaam</label>
                        <input type="text" asp-for="game.Name" class="form-control" required>
                    </div>
                </div>
                <div class="row">
                    <div class="mt-3 col-md-12">
                        <label asp-for="game.Type">Soort spel</label><br />
                        <select class="form-control" asp-for="game.Type">
                            <option>Kaartspel</option>
                            <option>Bordspel</option>
                            <option>Anders</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="mt-3 col-md-12">
                        <label asp-for="game.Genre">Genre</label><br />
                        <select class="form-control" asp-for="game.Genre">
                            <option>Actie</option>
                            <option>Strategie</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="mt-3 col-md-12">
                        <label asp-for="game.Is18Plus">18+</label><br />
                        <input style="transform: scale(0.7);" asp-for="game.Is18Plus" type="checkbox" class="form-control" />
                    </div>
                </div>
                <div class="row">
                    <div class="mt-3 col-md-12">
                        <label asp-for="game.Description">Beschrijving</label><br />
                        <textarea class="textareaDescription form-control" asp-for="game.Description" rows="4" placeholder="Beschrijving" required></textarea>
                    </div>
                </div>
                <div class="buttonContainer text-center mt-3 mb-3">
                    <button class="saveButton" type="submit">Voeg spel toe</button>
                    @if (Model.boardgames != null && Model.boardgames.Count != 0 )
                    {
                        <a class="gameNightLink btn mt-2" style="background-color:#964734; color:white" href="@Url.Action("OrganizedBoardGameNights", "Overview")">
                            Maak bordspelavond aan
                        </a>
                    }
                </div>
            </form>
        </div>
        <div class="added-games ml-4">
            <h5 class="row ml-2">Toegevoegde spellen</h5>
            <div class="row">
                @if (Model.boardgames != null && Model.boardgames.Any())
                {
                    foreach (var game in Model.boardgames)
                    {
                        <div class="card col-sm-6 col-md-3 col-lg-2 ml-4 mb-4">
                            <div class="card-body">
                                <div class="title-container">
                                    <h5 class="card-title">@game.Name</h5>
                                    @if (game.Is18Plus)
                                    {
                                        <span class="age-indicator">18+</span>
                                    }
                                </div>
                                <p class="card-text">
                                    <b>Type: </b> @game.Type <br />
                                    <b>Genre: </b> @game.Genre <br />
                                    <b>Beschrijving:</b> <br /> @game.Description
                                </p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Nog geen spellen toegevoegd</p>
                }
            </div>
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
        html, body {
        height: 100%;
        margin: 0;
        background-color: #AFDDE5;
        overflow-x: hidden;
    }

    .title {
        text-align: center;
        margin-top: 30px;
    }

    .addGamesForm {
        background-color: #0FA4AF;
        border-radius: 10px;
        color: black;
        font-weight: bold;
        padding: 10px 50px;
        margin-bottom: 50px;
    }

    input {
        width: 100%;
        height: 35px;
    }

    .textareaDescription {
        width: 100%;
    }

    .saveButton {
        width: 100%;
        max-width: 200px;
    }

    .saveButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }

    .card {
        background-color: darkcyan;
        color: white;
        border-radius: 8px;
        text-align: left;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card-title {
        font-size: 1.25em;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 0.95em;
        color: white;
    }

    .title-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .age-indicator {
        font-size: 1.1em;
        font-weight: bold;
        color: white;
        margin-left: 10px;
    }
</style>

