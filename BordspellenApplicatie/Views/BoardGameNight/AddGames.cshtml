@model AddGamesViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="title">
            <h1>Voeg spellen toe</h1>
        </div>
        <form class="addGamesForm" asp-action="AddGames" asp-controller="BoardGameNight" method="post">
            <div style="margin-top: 15px;">
                    <label asp-for="game.Name">Spelnaam</label>
                    <input type="text" asp-for="game.Name">
                </div>
            <div style="margin-top: 15px;">
                    <label asp-for="game.Type">Soort spel</label><br />
                    <select asp-for="game.Type">
                        <option>Kaartspel</option>
                        <option>Bordspel</option>
                        <option>Anders</option>
                    </select>
                </div>
            <div style="margin-top: 15px;">
                    <label asp-for="game.Genre">Genre</label><br />
                    <select asp-for="game.Genre">
                        <option>Actie</option>
                        <option>Strategie</option>
                    </select>
                </div>
            <div style="margin-top: 15px;">
                    <label asp-for="game.Is18Plus">18+</label><br />
                    <input style="transform: scale(0.7);" asp-for="game.Is18Plus" type="checkbox" />
                </div>
                <div style="margin-top: 15px;">
                    <label asp-for="game.Description">Beschrijving</label><br />
                    <textarea class="textareaDescription" asp-for="game.Description" rows="4" placeholder="Beschrijving"></textarea>
                </div>
            <div class="buttonContainer">
                <button class="saveButton" type="submit">Voeg spel toe</button>
            </div>
        </form>

        <div class="added-games">
            <h5>Toegevoegde spellen</h5>
            @if (Model.boardgames != null && Model.boardgames.Any())
            {
                foreach (var game in Model.boardgames)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            <h5 class="card-title">@game.Name</h5>
                            <p class="card-text">
                                Type: @game.Type <br />
                                Genre: @game.Genre <br />
                                18+: @(game.Is18Plus ? "Yes" : "No") <br />
                                Description: @game.Description
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No games have been added yet.</p>
            }
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
    }

    .addGamesForm {
        grid-column: 2/3;
        grid-row: 2/3;
    }

    input {
        width: 100%;
        height: 35px;
    }

    .textareaDescription {
        width: 100%;
    }

    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-bottom: 50px;
    }

    .saveButton {
        width: 100%;
        max-width: 200px;
    }

    .saveButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }

    .added-games {
        display: grid;
        grid-template-columns: repeat(5, 1fr); /* 5 columns */
        grid-template-rows: repeat(2, auto); /* 2 rows */
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background-color: #f4f4f4;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 1.25em;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 0.95em;
        color: #555;
    }
</style>

