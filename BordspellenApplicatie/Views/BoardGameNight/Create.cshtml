@using BordspellenApplicatie.Models
@model BoardGameNightDetailsViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="title">
            <h1>Maak bordspelavond aan</h1>
        </div>
        <form class="createBoardgamenightForm" asp-action="Create" asp-controller="BoardGameNight" method="post">
            <div style="margin-top: 15px;">
                 <label asp-for="Organizer">Naam organisator</label>
                 <input type="text" value="@User.Identity.Name" disabled />
                 <input type="hidden" asp-for="Organizer" value="@User.Identity.Name" />
            </div> 
            <div style="margin-top: 15px;">
                <label asp-for="DateTime">Datum</label>
                <input type="date" asp-for=DateTime />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Is18Plus">18+</label><br />
                <input style="transform: scale(0.7);" asp-for="Is18Plus" type="checkbox" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Title">Title</label>
                <input type="text" asp-for="Title" />
            </div>
            <div style ="margin-top: 15px;">
                <label asp-for="Description">Description</label><br />
                <textarea class="textareaDescription" asp-for="Description" rows="4"></textarea>
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="MaxPlayers">Max aantal spelers</label>
                <input type="number" asp-for="MaxPlayers" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Food">Eten & Drinken</label>
                <textarea class="textareaFood" asp-for="Food" rows="4"></textarea>
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Address.Street">Street</label><br />
                <input asp-for="Address.Street" type="text" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Address.Number">Number</label>
                <input asp-for="Address.Number" type="text" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Address.City">City</label>
                <input asp-for="Address.City" type="text" />
            </div>
            <div class="allergiesCheckbox">
                <h5>Allergieen</h5>
                <h5></h5>
                <label class="container">
                    <input asp-for="IsLactoseIntoleranceFriendly" type="checkbox">
                    Lactose allergie
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input asp-for="IsNutAllergyFriendly" type="checkbox">
                    Noten allergie
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input asp-for="IsVegetarianFriendly" type="checkbox">
                    Vegetarier
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input asp-for="IsNonAlcoholicFriendly" type="checkbox">
                    Drinkt geen alcohol
                    <span class="checkmark"></span>
                </label>
            </div>
            <div class="buttonContainer">
                <button class="saveButton" type="submit">Create bordspelavond</button>
            </div>
        </form>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
    }

    .createBoardgamenightForm {
        grid-column: 2/3;
        grid-row: 2/3;
    }

    input {
        width: 100%;
        height: 35px;
    }

    .textareaDescription, .textareaFood {
        width: 100%;
    }

    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-bottom: 50px;
    }

    .saveButton {
        width: 100%;
        max-width: 200px; 
    }

    .saveButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }

    .allergiesCheckbox {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 10px;
        margin-top: 15px;
    }

        .allergiesCheckbox input[type="checkbox"] {
            width: 16px;
            height: 16px;
            margin-right: 8px;
            vertical-align: middle;
        }

        .allergiesCheckbox .container {
            display: flex;
            align-items: center;
            font-size: 16px;
        }
</style>

