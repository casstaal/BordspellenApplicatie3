<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 3fr 0.5fr 3fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
    }

    .gameNightLink {
        color: black;
    }

        .gameNightLink:hover {
            text-decoration: none;
        }

    .plannedGames {
        grid-column: 2 / 5;
        grid-row: 2 / 3; 
        margin: 40px 40px 120px 40px;
    }

    .description-BoardgameNight {
        grid-column: 2/3;
        grid-row: 3/4;
    }

    .extra-information {
        grid-column: 2/3;
        grid-row: 4/5;
    }

    .address-information {
        grid-column: 2/3;
        grid-row: 5/6;
    }

    .description-food-drinks {
        grid-column: 4/5;
        grid-row: 3/6;
    }

    .signUpButton {
        grid-column: 2/3;
        grid-row: 6/7;
    }

    .review {
        grid-column: 4/5;
        grid-row: 6/7;
        margin-bottom: 50px;
    }

    .scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 10px;
        border: 1px solid #ddd;
    }

    .scroll-item {
        flex: 0 0 250px;
        margin-right: 15px;
        transition: transform 0.3s;
        width: 200px;
        background-color: aliceblue;
    }

        .scroll-item:hover {
            transform: scale(1.05);
        }
</style>