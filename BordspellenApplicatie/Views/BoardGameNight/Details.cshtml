    .scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 10px;
    }

    .title-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .scroll-item {
        margin-right: 15px;
        width: 200px;
        background-color: darkcyan;
        color: white;
        text-align: left;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        transition: transform 0.2s ease;
    }

        .scroll-item:hover {
            transform: scale(1.05);
        }
</style>


<script>
    async function deleteUserGameNight(gameNightId) {
        try {
            const response = await fetch(`/BoardGameNight/DeleteUserGameNight?gameNightId=${gameNightId}`, {
                method: 'DELETE',
            });

            if (response.ok) {
                alert("U bent succesvol uitgeschreven.");
                location.reload();
            } else {
                alert("Er is iets misgegaan bij het uitschrijven.");
            }
        } catch (error) {
            console.error("Error deleting game night:", error);
            alert("Er is een fout opgetreden.");
        }
    }
</script>