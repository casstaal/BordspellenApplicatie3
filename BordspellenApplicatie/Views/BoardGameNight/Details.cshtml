@model BordspellenApplicatie.Models.BoardGameNightDetailsViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <vc:header></vc:header>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-5 mt-3" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert"
                    aria-label="Sluiten">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-5 mt-3" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="close"
                    data-dismiss="alert"
                    aria-label="Sluiten">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-2"></div>
                <h1 class="title col-10">@Model.Title</h1>
            </div>
            <div class="row mb-5">
                <div class="col-2"></div>
                <div class="col-8">
                @if (Model.Organizer.Equals(User.Identity.Name))
                    {
                        <div class="row" style="margin-left: -2px; margin-bottom: 20px;">
                            <form asp-action="Delete" asp-controller="BoardGameNight" method="post" onsubmit="return confirm('Are you sure you want to delete this?');">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                            <a class="gameNightLink btn" style="background-color:#964734; color:white; margin-left: 10px" href="@Url.Action("Edit", "BoardGameNight", new { id = Model.Id })">
                                Edit
                            </a>
                        </div>
                    }

                @if (Model.CanWriteReview)
                {
                    <a class="btn"
                       style="background-color:#964734; color:white;"
                       asp-controller="Review"
                       asp-action="Create"
                       asp-route-id="@Model.Id">
                        Plaats review
                    </a>
                }
                <h3 class="col-12" style="margin-left: -20px; margin-bottom: -10px;">Geplande Bordspellen</h3>

                </div>
                <div class="col-2"></div>
                <div class="col-2"></div>
                <div class="scroll-container col-8">
                    <div class="row">
                        <div class="col-12 scroll-container">
                            @if (Model != null)
                            {
                                @foreach (var gameEvent in Model.Games)
                                {
                                    <div class="scroll-item card">
                                        <div class="card-body">
                                            <img src="/banner6.jpg" alt="Usert Icon" class="card-img" style="max-height: 100px;">
                                            <div class="title-container">
                                                <h5 class="card-title">@gameEvent.Name</h5>
                                                @if (gameEvent.Is18Plus)
                                                {
                                                    <span class="age-indicator">18+</span>
                                                }
                                            </div>
                                            <p>Genre: @gameEvent.Genre</p>
                                            <p class="card-text">Beschrijving: <br /> @gameEvent.Description</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p>Geen bordspelavonden gevonden.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
            <div class="row mb-5">
                <div class="col-2"></div>
                <div class="boardGameNightInformation col-8 p-4">
                    <div class="row">
                        <div class="row col-lg-6 col-md-6 col-sm-12">
                            <div class="descriptionBoardGameNight col-12">
                                <h5>Beschrijving bordspelavond</h5>
                                <p>@Model.Description</p>
                            </div>
                            <div class="extraInformation col-12 pt-3">
                                @if (@Model.Is18Plus == true)
                                {

                                <div class="mb-3">
                                    <p class="mb-1">
                                        <b>Organisator:</b> @Model.Organizer
                                    </p>

                                    <p class="mb-1">
                                        <b>Georganiseerde bordspelavonden:</b>
                                        @Model.OrganizerGameNightCount
                                    </p>

                                    @if (Model.OrganizerAverageScore.HasValue)
                                    {
                                        <p class="mb-1">
                                            <b>Gemiddelde beoordeling:</b>

                                            <span style="color: #964734; font-weight: bold;">
                                                ★ @Model.OrganizerAverageScore.Value.ToString("0.0") / 5
                                            </span>

                                            <small>
                                                (@Model.OrganizerReviewCount reviews)
                                            </small>
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="mb-1">
                                            <b>Gemiddelde beoordeling:</b>
                                            Nog geen beoordelingen
                                        </p>
                                    }
                                </div>

                                    <p><b>Date: </b> @Model.DateTime</p>
                                    <p><b>Leeftijd: </b> 18+</p>
                                }
                                else
                                {

                                <div class="mb-3">
                                    <p class="mb-1">
                                        <b>Organisator:</b> @Model.Organizer
                                    </p>

                                    <p class="mb-1">
                                        <b>Georganiseerde bordspelavonden:</b>
                                        @Model.OrganizerGameNightCount
                                    </p>

                                    @if (Model.OrganizerAverageScore.HasValue)
                                    {
                                        <p class="mb-1">
                                            <b>Gemiddelde beoordeling:</b>

                                            <span style="color: #964734; font-weight: bold;">
                                                ★ @Model.OrganizerAverageScore.Value.ToString("0.0") / 5
                                            </span>

                                            <small>
                                                (@Model.OrganizerReviewCount reviews)
                                            </small>
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="mb-1">
                                            <b>Gemiddelde beoordeling:</b>
                                            Nog geen beoordelingen
                                        </p>
                                    }
                                </div>

                                    <p><b>Date: </b> @Model.DateTime</p>
                                    <p><b>Leeftijd: </b> 16+</p>
                                }
                                <p><b>Aantal plekken: </b> @Model.MaxPlayers</p>
                                <p><b>Aantal open plekken: </b> @(Model.MaxPlayers - Model.UserBoardGameNights.Count())</p>
                            </div>
                            <div class="addressInformation col-12 pt-3">
                                <h5>Adress</h5>
                                <p><b>Straat: </b>Hogeschoollaan 29</p>
                                <p><b>Postcode: </b>2839PK</p>
                                <p><b>Breda: </b>Breda</p>
                            </div>
                        </div>
                        <div class="row col-lg-6 col-md-6 col-sm-12">
                            <h5>Beschrijving drinken en eten</h5>
                            <p>
                                Tijdens de bordspelavond is er niet alleen volop spelplezier, maar kun je ook genieten van een selectie heerlijke snacks en verfrissende drankjes! We zorgen voor een gevarieerd aanbod, zodat er voor iedereen wat lekkers is.
                            </p>
                            <div>
                                @Model.Food
                            </div><br />
                            <ul>
                                <li>
                                    Eten is lactose vrij: @Model.IsLactoseIntoleranceFriendly
                                </li>
                                <li>
                                    Eten is vegetarisch: @Model.IsVegetarianFriendly
                                </li>
                                <li>
                                    Eten bevat geen noten: @Model.IsNutAllergyFriendly
                                </li>
                                <li>
                                    Drinken is alcohol vrij: @Model.IsNonAlcoholicFriendly
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
            <div class="row mb-5">
                <div class="col-2"></div>
                <div class="col-8 playersSignedUp p-4">
                    <div class="row">
                        <h3 class="col-9">Aangemelde spelers</h3>
                    @{
                        var isFull = Model.UserBoardGameNights.Count >= Model.MaxPlayers;

                        var isRegistered = Model.UserBoardGameNights
                        .Any(ubgn => ubgn.User.Email == User.Identity.Name);

                        var isOrganizer = Model.Organizer == User.Identity.Name;
                    }

                    @if (!isOrganizer)
                    {

                        @if (isRegistered)
                        {
                            <div>
                                @if (Model.DateTime <= DateTime.Now)
                                {
                                    <div class="alert alert-info">
                                        Deze bordspelavond heeft al plaatsgevonden.
                                        Je was aangemeld voor deze avond.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success">
                                        Je bent ingeschreven voor deze spelavond.
                                    </div>

                                    <form asp-action="DeleteUserGameNight"
                                          asp-controller="BoardGameNight"
                                          method="post"
                                          onsubmit="return confirm('Weet je zeker dat je je wilt uitschrijven?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="gameNightId"
                                               value="@Model.Id" />

                                        <button type="submit" class="btn btn-danger">
                                            Uitschrijven
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        else if (Model.DateTime <= DateTime.Now)
                        {
                            <div class="alert alert-info">
                                Deze bordspelavond is al begonnen.
                                Inschrijven is niet meer mogelijk.
                            </div>
                        }

                        else if (isFull)
                        {
                            <div class="alert alert-warning">
                                Deze spelavond zit vol. Inschrijven is niet meer mogelijk.
                            </div>
                        }

                        else
                        {
                            var dietaryWarnings = new List<string>();

                            if (Model.IsLactoseIntolerant &&
                            !Model.IsLactoseIntoleranceFriendly)
                            {
                                dietaryWarnings.Add(
                                "Er is geen lactosevrij eten beschikbaar.");
                            }

                            if (Model.HasNutAllergy &&
                            !Model.IsNutAllergyFriendly)
                            {
                                dietaryWarnings.Add(
                                "Er is geen notenvrij eten beschikbaar.");
                            }

                            if (Model.IsVegetarian &&
                            !Model.IsVegetarianFriendly)
                            {
                                dietaryWarnings.Add(
                                "Er is geen vegetarisch eten beschikbaar.");
                            }

                            if (!Model.DrinksAlcohol &&
                            !Model.IsNonAlcoholicFriendly)
                            {
                                dietaryWarnings.Add(
                                "Er zijn geen alcoholvrije dranken beschikbaar.");
                            }

                            <div>
                                @if (dietaryWarnings.Any())
                                {
                                    <div class="alert alert-warning">
                                        <strong>Let op!</strong>
                                        Het eten en drinken sluit mogelijk niet volledig
                                        aan op jouw dieetwensen of allergieën.

                                        <ul class="mt-2 mb-0">
                                            @foreach (var warning in dietaryWarnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <form asp-action="SignUp"
                                      asp-controller="BoardGameNight"
                                      method="post"
                                      onsubmit="return confirmSignUp(this);">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="gameNightId"
                                           value="@Model.Id" />

                                    <button type="submit" class="btn btn-primary">
                                        Inschrijven
                                    </button>
                                </form>
                            </div>

                            <script>
                                function confirmSignUp(form) {
                                    const warnings = @Html.Raw(
                                                                        System.Text.Json.JsonSerializer.Serialize(dietaryWarnings)
                                                                );

                            if (warnings.length > 0) {
                                const message =
                                    "Let op! Het eten en drinken sluit niet volledig " +
                                    "aan op jouw dieetwensen of allergieën.\n\n" +
                                    warnings.map(w => "• " + w).join("\n") +
                                    "\n\nWeet je zeker dat je je wilt inschrijven?";

                                        return confirm(message);
                                    }

                                    return confirm(
                                        "Weet je zeker dat je je wilt inschrijven?"
                                    );
                                }
                            </script>
                                        }

                    }
                </div>
                    <div>
                    @if (Model.UserBoardGameNights != null && Model.UserBoardGameNights.Any())
                        {
                            @foreach (var userBoardGameNight in Model.UserBoardGameNights)
                            {
                                <div>- @userBoardGameNight.User.FirstName @userBoardGameNight.User.LastName</div>
                            }
                        }
                        else
                        {
                            <p>Nog geen aangemelde spelers</p>
                        }
                    </div>
                </div>
                <div class="col-2"></div>
            </div>

        <div class="row mb-5">
            <div class="col-2"></div>

            <div class="col-8 boardGameNightInformation p-4">
                <h3 class="mb-4">Reviews van deze bordspelavond</h3>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="card mb-3 p-3"
                             style="background-color:#AFDDE5; border-radius:8px;">

                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-1">
                                    @review.Author?.FirstName
                                    @review.Author?.LastName
                                </h5>

                                <span style="color:#964734; font-weight:bold;">
                                    ★ @review.Score / 5
                                </span>
                            </div>

                            <small class="text-muted mb-2">
                                @review.Date.ToString("dd-MM-yyyy")
                            </small>

                            <h6><b>@review.Title</b></h6>

                            <p class="mb-0">
                                @review.TextReview
                            </p>
                        </div>
                    }
                }
                else
                {
                    <p>Er zijn nog geen reviews voor deze bordspelavond.</p>
                }
            </div>

            <div class="col-2"></div>
        </div>


        </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>

    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
    }

    .gameNightLink {
        color: black;
    }

        .gameNightLink:hover {
            text-decoration: none;
        }

    .boardGameNightInformation {
        background-color: #0FA4AF;
        border-radius: 8px;
    }

    .age-indicator {
        font-size: 1.1em;
        font-weight: bold;
        color: white;
        margin-left: 10px;
        margin-bottom: 5px;
    }

    .scroll-container {
        display: flex;
        overflow-x: auto;
        flex-wrap: nowrap;
        scroll-behavior: smooth;
        padding: 10px;
    }

        .scroll-container::-webkit-scrollbar {
            display: none;
        }

    .playersSignedUp {
        min-height: 200px;
        background-color: #0FA4AF;
        border-radius: 8px;
    }

    .title-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .back-button {
        background-color: #964734;
        color: white;
        border-radius: 4px;
        padding-right: 100px;
    }

    .scroll-item {
        margin-right: 15px;
        width: 200px;
        background-color: darkcyan;
        color: white;
        text-align: left;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        transition: transform 0.2s ease;
    }

        .scroll-item:hover {
            transform: scale(1.05);
        }
</style>


<script>
    async function deleteUserGameNight(gameNightId) {
        try {
            const response = await fetch(`/BoardGameNight/DeleteUserGameNight?gameNightId=${gameNightId}`, {
                method: 'DELETE',
            });

            if (response.ok) {
                alert("U bent succesvol uitgeschreven.");
                location.reload();
            } else {
                alert("Er is iets misgegaan bij het uitschrijven.");
            }
        } catch (error) {
            console.error("Error deleting game night:", error);
            alert("Er is een fout opgetreden.");
        }
    }
</script>