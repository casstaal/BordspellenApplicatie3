@model BordspellenApplicatie.Models.BoardGameNightDetailsViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
            <h2 class="title col-12">@Model.Title</h2>
            <div class="row mb-5">
                <div class="col-2"></div>
                <div class="scroll-container col-8">
                    <div class="row">
                    <form asp-action="DeleteUserGameNight" asp-controller="BoardGameNight" method="post" onsubmit="return confirm('Are you sure you want to delete this?');">
                        <input type="hidden" name="gameNightId" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <a class="gameNightLink btn" style="background-color:#964734; color:white" href="@Url.Action("Edit", "BoardGameNight", new { id = Model.Id })">
                        Edit
                    </a>
                    <h3 class="col-12">Geplande Bordspellen</h3>
                        <div class="col-12">
                            @if (Model != null)
                            {
                                @foreach (var gameEvent in Model.Games)
                                {
                                    <div class="scroll-item card">
                                        <div class="card-body">
                                            <img src="/banner6.jpg" alt="Usert Icon" class="card-img" style="max-height: 100px;">
                                            <div class="title-container">
                                                <h5 class="card-title">@gameEvent.Name</h5>
                                                @if (!gameEvent.Is18Plus)
                                                {
                                                    <span class="age-indicator">18+</span>
                                                }
                                            </div>
                                            <p>Genre: @gameEvent.Genre</p>
                                            <p class="card-text">Beschrijving: <br /> @gameEvent.Description</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p>Geen bordspelavonden gevonden.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
            <div class="row mb-5">
                <div class="col-2"></div>
                <div class="boardGameNightInformation col-8 p-4">
                    <div class="row">
                        <div class="row col-6">
                            <div class="descriptionBoardGameNight col-12">
                                <h5>Beschrijving bordspelavond</h5>
                                <p>@Model.Description</p>
                            </div>
                            <div class="extraInformation col-12 pt-3">
                                @if (@Model.Is18Plus == true)
                                {
                                    <p><b>Organisator: </b>@Model.Organizer <b>Date: </b> @Model.DateTime <b>Leeftijd: </b> 18+</p>
                                }
                                else
                                {
                                    <p><b>Organisator: </b>@Model.Organizer <b>Date: </b> @Model.DateTime <b>Leeftijd: </b> 16+</p>
                                }
                                <p><b>Aantal plekken: </b> @Model.MaxPlayers</p>
                                <p><b>Aantal open plekken: </b> nog maken</p>
                            </div>
                            <div class="addressInformation col-12 pt-3">
                                <h5>Adress</h5>
                                <p>Hogeschoollaan 29</p>
                                <p>2839PK</p>
                                <p>Breda</p>
                            </div>
                        </div>
                        <div class="row col-6">
                            <h5>Beschrijving drinken en eten</h5>
                            <p>
                                Tijdens de bordspelavond is er niet alleen volop spelplezier, maar kun je ook genieten van een selectie heerlijke snacks en verfrissende drankjes! We zorgen voor een gevarieerd aanbod, zodat er voor iedereen wat lekkers is.
                            </p>
                            <h7>Hartige snacks</h7>
                            <ul>
                                <li>
                                    Mini-sandwiches met verschillende belegopties zoals kaas, kipfilet en hummus.
                                </li>
                                <li>
                                    Kaasblokjes, worstjes en olijven om gemakkelijk tussendoor te snacken.
                                </li>
                                <li>
                                    Zoute crackers en chips voor de liefhebbers van iets knapperigs.
                                </li>
                            </ul>
                            <h7>Zoete tussendoortjes</h7>
                            <ul>
                                <li>
                                    Vers fruit zoals appelpartjes, druiven en mandarijntjes.
                                </li>
                                <li>
                                    Chocolade en koekjes om de zoetekauw in jou te plezieren.
                                </li>
                                <li>
                                    Kleine gebakjes of cakejes voor een extra traktatie.
                                </li>
                            </ul>
                            <h7>Drankjes</h7>
                            <ul>
                                <li>
                                    Verfrissende frisdranken zoals cola, sinas, en bruiswater.
                                </li>
                                <li>
                                    Vruchtensappen zoals sinaasappel- en appelsap.
                                </li>
                                <li>
                                    Koffie en thee voor een warme opkikker tijdens het spelen.
                                </li>
                                <li>
                                    Water voor iedereen die iets lichts wil drinken.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
