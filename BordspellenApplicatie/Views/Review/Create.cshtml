@model BordspellenApplicatie.Models.ReviewViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review plaatsen</title>

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

    <style>
        body {
            background-color: #AFDDE5;
        }

        .review-container {
            max-width: 650px;
            margin: 40px auto 80px;
            padding: 0 20px;
        }

        .review-form {
            background-color: #0FA4AF;
            padding: 30px;
            border-radius: 10px;
        }

            .review-form label {
                font-weight: bold;
            }

        .back-button {
            display: inline-block;
            background-color: #964734;
            color: white;
            padding: 10px 25px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

            .back-button:hover {
                color: white;
                text-decoration: none;
                background-color: #763728;
            }

        .save-button {
            background-color: #964734;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 6px;
            cursor: pointer;
        }

            .save-button:hover {
                background-color: #763728;
            }
    </style>
</head>
<body>
    <vc:header></vc:header>

    <main class="review-container">
        <h1 class="text-center mb-4">Review plaatsen</h1>

        <a asp-controller="BoardGameNight"
           asp-action="Details"
           asp-route-id="@Model.BoardGameNightId"
           class="back-button">
            Terug
        </a>

        <form asp-action="Create"
              asp-controller="Review"
              method="post"
              class="review-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="BoardGameNightId" />

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="form-group">
                <label>Auteur</label>
                <input type="text"
                       class="form-control"
                       value="@User.Identity?.Name"
                       disabled />
            </div>

            <div class="form-group">
                <label asp-for="Title">Titel</label>
                <input asp-for="Title"
                       class="form-control"
                       maxlength="150"
                       required />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Score">Score (1–5)</label>
                <select asp-for="Score"
                        class="form-control"
                        required>
                    <option value="0">Kies een score</option>
                    <option value="1">1 - Zeer slecht</option>
                    <option value="2">2 - Slecht</option>
                    <option value="3">3 - Gemiddeld</option>
                    <option value="4">4 - Goed</option>
                    <option value="5">5 - Uitstekend</option>
                </select>
                <span asp-validation-for="Score"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TextReview">Reviewtekst</label>
                <textarea asp-for="TextReview"
                          class="form-control"
                          rows="5"
                          required
                          placeholder="Hoe heb je de bordspelavond ervaren?"></textarea>
                <span asp-validation-for="TextReview"
                      class="text-danger"></span>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="save-button">
                    Review plaatsen
                </button>
            </div>
        </form>
    </main>

    <vc:footer></vc:footer>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
