@{
    Layout = null;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="navigation">
            <p>
                Homepage / <b>Overzicht bordspellenavonden</b>
            </p>
            <h1>
                Overzicht bordspellenavonden
            </h1>
        </div>
        <div class="grid-container">
            @if (futureEvents != null && futureEvents.Count > 0)
            {
                foreach (var eventItem in futureEvents)
                {
                    <div class="card">
                        <img src="/banner6.jpg" alt="Usert Icon" class="card-img" style="max-height: 100px;">
                        <h5 class="card-title">@eventItem.Title</h5>
                        <p class="card-text">
                            Date: @eventItem.Date.ToString("MMMM dd, yyyy")<br />
                            18+: @(eventItem.Is18Plus ? "Yes" : "No")
                        </p>
                    </div>
                }
            }
            else
            {
                <p>No upcoming board game nights available.</p>
            }
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .navigation {
        margin-bottom: 20px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr); /* 5 columns */
        grid-template-rows: repeat(2, auto); /* 2 rows */
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background-color: #f4f4f4;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 1.25em;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 0.95em;
        color: #555;
    }
</style>

