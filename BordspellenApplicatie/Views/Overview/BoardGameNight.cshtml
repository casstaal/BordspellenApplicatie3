@model IEnumerable<BordspellenApplicatie.Domain.Models.BoardGameNight>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <div class="navigation">
                <p>
                    Homepage / <b>Overzicht bordspellenavonden</b>
                </p>
                <h1>
                    Overzicht bordspellenavonden
                </h1>
            </div>
            <div class="grid-container">
                @if (Model != null)
                {
                    foreach (var boardGameNight in Model)
                    {
                        <a class="gameNightLink" href="@Url.Action("Details", "BoardGameNight", new { id = boardGameNight.Id, title = boardGameNight.Title, date = boardGameNight.DateTime.ToString("yyyy-MM-dd") })">
                            <div class="card">
                                <img src="/banner6.jpg" alt="User Icon" class="card-img" style="max-height: 100px;">
                                <h5 class="card-title">@boardGameNight.Title</h5>
                                <p class="card-text">
                                    Date: @boardGameNight.DateTime.ToString("MMMM dd, yyyy")<br />
                                </p>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <p>No board game nights found.</p>
                }
            </div>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .navigation {
        margin-bottom: 20px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr); /* 5 columns */
        grid-template-rows: repeat(2, auto); /* 2 rows */
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background-color: #f4f4f4;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 1.25em;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 0.95em;
        color: #555;
    }
</style>

