@model IEnumerable<BordspellenApplicatie.Domain.Models.BoardGameNight>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <div style="margin-top: 10px; margin-left: 50px;" class="navigation">
                <p>
                    Homepage / <b>Overzicht bordspellenavonden</b>
                </p>
                <h1>
                    Overzicht bordspellenavonden
                </h1>
            </div>
            <div class="grid-container">
                @if (Model != null)
                {
                    foreach (var boardGameNight in Model)
                    {
                        <div class="card">
                            <img src="/banner6.jpg" alt="User Icon" class="card-img" style="max-height: 100px;">
                            <div class="title-container">
                                <h5 class="card-title">@boardGameNight.Title</h5>
                                @if (!boardGameNight.Is18Plus)
                                {
                                    <span class="age-indicator">18+</span>
                                }
                            </div>
                            <p class="card-text">
                                Date: @boardGameNight.DateTime.ToString("MMMM dd, yyyy")<br />
                            </p>
                            <a class="gameNightLink btn" style="background-color:#964734; color:white" href="@Url.Action("Details", "BoardGameNight", new { id = boardGameNight.Id, title = boardGameNight.Title, date = boardGameNight.DateTime.ToString("yyyy-MM-dd") })">
                                Zie details
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p>No board game nights found.</p>
                }
            </div>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
        font-family: Calibri;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .navigation {
        margin-bottom: 20px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: repeat(2, auto); 
        gap: 20px;
        margin-top: 20px;
        margin-left: 50px;
    }

    .card {
        background-color: darkcyan;
        padding: 20px;
        border-radius: 8px;
        text-align: left;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
        color: white;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .title-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .age-indicator {
        font-size: 1.1em;
        font-weight: bold;
        color: white;
        margin-left: 10px;
    }

    .card-title {
        font-size: 1.25em;
        margin-top: 7px;
    }

    .card-text {
        font-size: 0.95em;
        color: white;
    }
</style>

