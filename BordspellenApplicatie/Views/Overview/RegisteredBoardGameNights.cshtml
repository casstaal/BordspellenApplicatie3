@model IEnumerable<BordspellenApplicatie.Models.BoardGameNightDetailsViewModel>

@{
    Layout = null;
    var bannerUrl = ViewBag.BannerUrl as string;
    var infoText = ViewBag.InfoText as string;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Domain.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="navigation">
            <p>
                Homepage / <b>Overzicht aangemelde bordspellenavonden</b>
            </p>
            <h1>
                Overzicht aangemelde bordspellenavonden
            </h1>
        </div>
        <div class="grid-container">
            @if (Model != null)
            {
                foreach (var boardGameNight in Model)
                {
                    <div class="card">
                        <img src="/banner6.jpg" alt="User Icon" class="card-img" style="max-height: 100px;">
                        <h5 class="card-title">@boardGameNight.Title</h5>
                        <p class="card-text">
                            Date: @boardGameNight.DateTime.ToString("MMMM dd, yyyy")<br />
                        </p>
                    </div>
                }
            }
            else
            {
                <p>No board game nights found.</p>
            }
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        background-color: aliceblue;
    }

    .navbar {
        grid-column: 1 / 5;
        grid-row: 1 / 2;
        background-color: lightgrey;
        padding: 10px;
        background-color: lightsteelblue;
    }

    .navigation {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        padding-left: 50px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr); /* 5 columns */
        grid-template-rows: repeat(2, auto); /* 2 rows */
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background-color: #f4f4f4;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 1.25em;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 0.95em;
        color: #555;
    }
</style>

