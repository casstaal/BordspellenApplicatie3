@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="title">
            <h1>Create your account</h1>
            <p>Maak een account aan om bordspelavonden te organiseren en je aan te melden voor bordspelavonden</p>
        </div>
        <form class="loginForm">
            <div>
                <label asp-for="FirstName">Voornaam</label><br />
                <input asp-for="FirstName" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="LastName">Achternaam</label><br />
                <input asp-for="LastName" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="DateOfBirth">Geboortedatum</label><br />
                <input asp-for="DateOfBirth" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Email">Email</label><br />
                <input asp-for="Email" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Phonenumber">Telefoonnummer</label><br />
                <input asp-for="Phonenumber" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Password">Wachtwoord</label><br />
                <input asp-for="Password" />
            </div>
            <div class="allergiesCheckbox">
                <label class="container">
                    <input type="checkbox">
                    Lactose allergie
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input type="checkbox">
                    Noten allergie
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input type="checkbox">
                    Vegetarier
                    <span class="checkmark"></span>
                </label>
                <label class="container">
                    <input type="checkbox">
                    Drinkt geen alcohol
                    <span class="checkmark"></span>
                </label>
            </div>
            <div class="buttonContainer">
                <button class="saveButton" type="submit">Create account</button>
            </div>
        </form>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
    }

    .loginForm {
        grid-column: 2/3;
        grid-row: 2/3;
    }

    input {
        width: 100%;
        height: 35px;
    }


    .signUp {
        grid-column: 2/3;
        grid-row: 3/4;
        margin-top: 50px;
    }

    /* Centering buttons within their containers */
    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-bottom: 50px;
    }

    .saveButton, .signUpButton {
        width: 100%;
        max-width: 200px; /* Adjust the width as needed */
    }

    /* Optional: Styling for the buttons */
    .saveButton, .signUpButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }


    .allergiesCheckbox {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Two columns */
        gap: 10px;
        margin-top: 15px;
    }

        /* Style for smaller checkboxes */
        .allergiesCheckbox input[type="checkbox"] {
            width: 16px;
            height: 16px;
            margin-right: 8px;
            vertical-align: middle;
        }

        .allergiesCheckbox .container {
            display: flex;
            align-items: center;
            font-size: 16px;
        }
</style>

