@{
    Layout = null;
    var bannerUrl = ViewBag.BannerUrl as string;
    var infoText = ViewBag.InfoText as string;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
@*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>

    <!-- Main container with grid layout -->
    <div class="container-fluid">

        <!-- Navbar (spanning columns 1 to 3) -->
        <div class="navbar d-flex justify-content-between align-items-center">
            <div class="logo">
                <img src="/logoBoardgame.jpg" alt="Logo" class="img-fluid" style="max-height: 50px;">
            </div>
            <a href="/account/details">
                <img src="/userIcon.png" alt="User Icon" class="img-fluid" style="max-height: 40px;">
            </a>
        </div>

        <!-- Banner in the middle (column 2) -->
        <div class="banner">
            <img src="@bannerUrl" alt="Banner" class="img-fluid" style="max-height: 400px;">
        </div>

        <!-- Info Section centered (column 2) -->
        <div class="info-section">
            <h3>Info over wat de bordspelavonden zijn</h3>
            <p>@infoText</p>
        </div>

        <!-- Scroll container (spanning columns 1 to 3) -->
        <div class="scroll-container">
            <h3>Toekomstige bordspelavonden</h3>
            @if (futureEvents != null && futureEvents.Any())
            {
                @foreach (var gameEvent in futureEvents)
                {
                    <div class="scroll-item card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@gameEvent.Title</h5>
                            <p class="card-text">Date: @gameEvent.Date.ToString("dd MMM yyyy")</p>
                            <p class="card-text">Age Restriction: @(gameEvent.Is18Plus ? "18+" : "All Ages")</p>
                        </div>
                    </div>
                }
            }
        </div>

    </div>

    <!-- Bootstrap and jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    /* Main grid container */
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 6fr 1fr;
        gap: 10px;
    }

    /* Navbar spanning columns 1 to 3 */
    .navbar {
        grid-column: 1 / 5; /* Span across the first three columns */
        grid-row: 1 / 2;
        background-color: lightgrey;
        padding: 10px;
    }

    /* Banner in the middle (centered in column 2) */
    .banner {
        grid-column: 2 / 3; /* Span across columns 2 to 3 */
        grid-row: 2 / 3;
        display: block;
        margin-left: auto;
        margin-right: auto;
        width: 50%;
    }

    /* Info section centered in the middle column */
    .info-section {
        grid-column: 2 / 3; /* Span across columns 2 to 3 */
        grid-row: 3 / 4;
        text-align: center;
    }

    /* Scroll container spanning columns 1 to 3 */
    .scroll-container {
        grid-column: 1 / 5; /* Span across the first three columns */
        grid-row: 4 / 5;
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 10px;
        border: 1px solid #ddd;
    }

    /* Scroll items */
    .scroll-item {
        flex: 0 0 250px; /* Control width of each item */
        margin-right: 15px;
        transition: transform 0.3s;
    }

        .scroll-item:hover {
            transform: scale(1.05); /* Slight zoom effect on hover */
        }
</style> 

