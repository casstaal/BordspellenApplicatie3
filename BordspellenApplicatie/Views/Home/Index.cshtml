@model IEnumerable<BordspellenApplicatie.Domain.Models.BoardGameNight>

@{
    Layout = null;
    var bannerUrl = ViewBag.BannerUrl as string;
    // var infoText = ViewBag.InfoText as string;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Domain.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
@*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="banner">
            <img src="@bannerUrl" alt="Banner" class="img-fluid" style="min-width: 1000px;">
            <div class="text-banner ">
                <h1 style="font-size: 55px;">Bordspelavonden</h1>
                <p style="font-size: 25px;">Welkom op onze bordspelavond site voor immigranten!</p>
            </div>
        </div>
        <div class="info-section">
            <p>Ben je nieuw in Nederland en wil je op een leuke en ontspannen manier de Nederlandse taal leren? Kom dan naar onze gezellige bordspellenavonden. Hier combineren we taalvaardigheid met spelplezier!</p>
            <p>Tijdens deze avonden speel je samen met anderen verschillende bordspellen, waarbij je op een speelse manier je Nederlands oefent. Het is een perfecte gelegenheid om nieuwe mensen te ontmoeten, de taal in praktijk te brengen en spelenderwijs je woordenschat en taalbegrip te verbeteren.</p>
            <p>Of je nu een beginner bent of al wat verder gevorderd, iedereen is welkom. Onze vrijwilligers begeleiden de avond en helpen je graag met moeilijke woorden of zinnen. Het belangrijkste is dat je plezier hebt terwijl je leert!</p>
            <p>Doe mee, verbeter je Nederlands en ontdek hoe leuk taal leren kan zijn!</p>
        </div>
        <div class="futureBoardGameNights">
            <div class="title-container">
                <h3>Toekomstige bordspelavonden</h3>
                @Html.ActionLink("Toon alle bordspelavonden", "BoardGameNight", "Overview", null, new { @class = "bordspelavonden-link" })
            </div>
            @*<button class="scroll-button left" onclick="scrollLeft()">Left</button>*@
            <div class="scroll-container">
                @if (Model != null)
                {
                    @foreach (var gameEvent in Model)
                    {
                        <a class="gameNightLink" href="@Url.Action("Details", "BoardGameNight", new { id = gameEvent.Id, title = gameEvent.Title, date = gameEvent.DateTime.ToString("yyyy-MM-dd") })">
                            <div class="scroll-item card text-center">
                                <div class="card-body">
                                    <img src="/banner6.jpg" alt="Usert Icon" class="card-img" style="max-height: 100px;">
                                    <h5 class="card-title">@gameEvent.Title</h5>
                                    <p class="card-text">Date: @gameEvent.DateTime.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                        </a>
                    }
                } else
                {
                    <p>Geen bordspelavonden gevonden.</p>
                }
            </div>
@*             <button class="scroll-button right" onclick="scrollRight()">Right</button> *@        
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>

    html, body {
        background-color: #AFDDE5;
        font-family: Arial;
    }
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 4fr 1fr;
        gap: 10px;
        /*background-color: aliceblue;*/
    }

    .banner {
        grid-column: 1 / -1; 
        grid-row: 2 / 3;
        display: block;
        width: 100%; 
        margin: 0; 
        padding: 0; 
        margin-left: 4px;
        margin-top: 12px;
        position: relative;
        text-align: center;
        color: white;
    }

/*     .text-banner {
        position: absolute;
        bottom: 8px;
        left: 16px;
    } */

    .text-banner {
        position: absolute;
        bottom: 8px;
        left: 16px;
        text-align: left; /* Aligns the content to the left */
    }

        .text-banner h1,
        .text-banner p {
            text-align: left; /* Ensures all text inside text-banner aligns to the left */
        }

    .info-section {
        grid-column: 2 / 3;
        grid-row: 3 / 4;
        text-align: left;
        background-color: #024950;
        color: white;
        padding: 50px 60px 50px 60px;
        border-radius: 5px;
        margin-top: 100px;
    }

    .gameNightLink {
        color: black;
    }

    .gameNightLink:hover {
        text-decoration: none;
    }

    .futureBoardGameNights {
        grid-column: 1 / 5; 
        grid-row: 4 / 5;
        margin: 60px 40px 120px 40px;
        margin-top: 150px;
    }

    .scroll-container {

        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 10px;
        @*width: calc(100% - 60px);*@
    }

        .scroll-container::-webkit-scrollbar {
            display: none;
        }

    .scroll-item {
        flex: 0 0 250px; 
        margin-right: 15px;
        transition: transform 0.3s;
        width: 200px;
        background-color: aliceblue;
    }

    .scroll-item:hover {
        transform: scale(1.05); 
    }


