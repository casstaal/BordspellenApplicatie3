    .title-container {
        display: flex;
        align-items: center; 
    }

    .bordspelavonden-link {
        color: #964734;
        margin-left: auto;
        font-weight: bold;
    }

    .bordspelavonden-link:hover {
        color: #964734;
    }
</style> 

