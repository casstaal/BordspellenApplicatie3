@{
    Layout = null;
    var bannerUrl = ViewBag.BannerUrl as string;
    var infoText = ViewBag.InfoText as string;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
@*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <div class="container-fluid">
        <div class="navbar d-flex justify-content-between align-items-center">
            <div class="logo">
                <img src="/logoBoardgame.jpg" alt="Logo" class="img-fluid" style="max-height: 50px;">
            </div>
            <a href="/account/details">
                <img src="/userIcon.png" alt="User Icon" class="img-fluid" style="max-height: 40px;">
            </a>
        </div>
        <div class="banner">
            <img src="@bannerUrl" alt="Banner" class="img-fluid" style="min-width: 1000px; max-height: 300px">
        </div>
        <div class="info-section">
            <p>@infoText</p>
        </div>
        <div class="futureBoardGameNights">
            <h3>Toekomstige bordspelavonden</h3>
            <div class="scroll-container">
                @if (futureEvents != null && futureEvents.Any())
                {
                    @foreach (var gameEvent in futureEvents)
                    {
                        <a class="gameNightLink" href="@Url.Action("Details", "BoardGameNight", new { id = gameEvent.Id, title = gameEvent.Title, date = gameEvent.Date.ToString("yyyy-MM-dd"), is18Plus = gameEvent.Is18Plus })">
                            <div class="scroll-item card text-center">
                                <div class="card-body">
                                    <img src="/boardgame.jpg" alt="User Icon" class="card-img" style="max-height: 100px;">
                                    <h5 class="card-title">@gameEvent.Title</h5>
                                    <p class="card-text">Date: @gameEvent.Date.ToString("dd MMM yyyy")</p>
                                    <p class="card-text">Age Restriction: @(gameEvent.Is18Plus ? "18+" : "All Ages")</p>
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>


    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 6fr 1fr;
        gap: 10px;
        /*background-color: aliceblue;*/
    }

    .navbar {
        grid-column: 1 / 5;
        grid-row: 1 / 2;
        background-color: lightsteelblue;
        padding: 10px;
    }

    .banner {
        grid-column: 2 / 3; 
        grid-row: 2 / 3;
        display: block;
        margin-left: auto;
        margin-right: auto;
        margin-top: 50px;
    }

    .info-section {
        grid-column: 2 / 3;
        grid-row: 3 / 4;
        text-align: left;
        margin-top: 10px;
    }

    .gameNightLink {
        color: black;
    }

    .gameNightLink:hover {
        text-decoration: none;
    }

    .futureBoardGameNights {
        grid-column: 1 / 5; 
        grid-row: 4 / 5;
        margin: 60px 40px 120px 40px;
    }

    .scroll-container {

        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 10px;
        border: 1px solid #ddd;
    }

    .scroll-item {
        flex: 0 0 250px; 
        margin-right: 15px;
        transition: transform 0.3s;
        width: 200px;
        background-color: aliceblue;
    }

    .scroll-item:hover {
        transform: scale(1.05); 
    }
</style> 

