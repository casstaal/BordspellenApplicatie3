@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <h1 class="title">Login</h1>

        <form class="loginForm">
            <div>
                <label>Email</label><br />
                <input/>
            </div>
            <div style="margin-top: 15px;">
                <label>Password</label><br />
                <input />
            </div>
            <div>
                <p style="text-align: center; margin-top: 10px;">Wachtwoord vergeten</p>
            </div>
            <div class="buttonContainer">
                <button class="saveButton" type="submit">Login</button>
            </div>
        </form>

        <div class="signUp">
            <p style="text-align: center;">Ik heb nog geen account</p>
            <div class="buttonContainer">
                <button class="signUpButton">Sign Up</button>
            </div>
        </div>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
    }

    .loginForm {
        grid-column: 2/3;
        grid-row: 2/3;
    }

    input {
        width: 100%;
        height: 35px;
    }


    .signUp {
        grid-column: 2/3;
        grid-row: 3/4;
        margin-top: 50px;
    }

    /* Centering buttons within their containers */
    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
    }

    .saveButton, .signUpButton {
        width: 100%;
        max-width: 200px; /* Adjust the width as needed */
    }

    /* Optional: Styling for the buttons */
    .saveButton, .signUpButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }
</style>

