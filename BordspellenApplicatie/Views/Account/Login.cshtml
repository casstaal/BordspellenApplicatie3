@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <h1 class="title">Login</h1>
            <form asp-action="Login" method="post" class="loginForm">
                <div><span asp-validation-for="Name" class="text-danger"></span></div>
                <div>
                    <label asp-for="Name">Email</label><br />
                    <input asp-for="Name" type="text" />
                </div>
                <div style="margin-top: 15px;">
                    <label asp-for="Password">Wachtwoord</label><br />
                    <input asp-for="Password" type="password" />
                </div>
                <div asp-validation-summary="All"></div>
                <div class="buttonContainer">
                    <button class="saveButton" type="submit">Login</button>
                </div>
            </form>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }

    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
        margin-bottom: 20px;
    }

    .loginForm {
        grid-column: 2/3;
        grid-row: 2/3;
        background-color: #0FA4AF;
        padding: 20px;
        margin-bottom: 85px;
        border-radius: 10px;
        padding-top: 30px;
        color: white;
    }

    input {
        width: 100%;
        height: 35px;
    }


    .signUp {
        grid-column: 2/3;
        grid-row: 3/4;
        margin-top: 50px;
    }

    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-top: 30px;
        margin-bottom: -85px;
 
    }

    .saveButton {
        width: 100%;
        max-width: 200px;
    }

    .saveButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }
</style>

