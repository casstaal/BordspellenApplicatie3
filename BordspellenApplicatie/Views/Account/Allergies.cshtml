@model BordspellenApplicatie.Domain.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <div class="row ml-5 mt-2">
                <p class="col-12">
                    Home / Mijn Account / <b>Allergieen</b>
                </p>
                <h1 class="col-12">
                    Mijn Account
                </h1>
            </div>
            <div class="row ml-5 mt-4">
                <div class="col-4">
                        @Html.ActionLink("Mijn details", "Details", "Account", null, new { @class = "account-link" })
                        <br />
                        @Html.ActionLink("Aangemelde bordspelavonden", "Registered", "Account", null, new { @class = "account-link" })
                        <br />
                        @Html.ActionLink("Georganiseerde bordspelavonden", "Organized", "Account", null, new { @class = "account-link" })
                        <br />
                        @Html.ActionLink("Dieetwensen en allergieen", "Allergies", "Account", null, new { @class = "account-link-selected", @style = "background-color: #0FA4AF; color: white;" })
                        <br />
                </div>
                <div class="col-1"></div>
                <div class="col-6 detailsForm mb-5">
                    <h3 style="margin-top: 20px; margin-bottom: 20px;">Allergieen</h3>
                    <form>
                        <div>
                            <label asp-for="IsLactoseIntolerant">Lactose Allergy</label>
                            <input asp-for="IsLactoseIntolerant" type="checkbox" />
                        </div>
                        <div>
                            <label asp-for="HasNutAllergy">Nut Allergy</label>
                            <input asp-for="HasNutAllergy" type="checkbox" />
                        </div>
                        <div>
                            <label asp-for="IsVegetarian">Vegan</label>
                            <input asp-for="IsVegetarian" type="checkbox" />
                        </div>
                        <div>
                            <label asp-for="DrinksAlcohol">Drinks Alcohol</label>
                            <input asp-for="DrinksAlcohol" type="checkbox" />
                        </div>
                        <button class="saveButton" type="submit">Opslaan</button>
                    </form>
                </div>
            </div>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .detailsForm {
        background-color: #0FA4AF;
        border-radius: 10px;
        color: black;
        font-weight: bold;
    }

    .account-link {
        color: black;
        display: block;
    }

    .account-link-selected {
        color: black;
        display: block;
        padding-left: 5px;
        margin-left: -5px;
        border-radius: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        margin-right: 100px;
    }

        .account-link-selected:hover {
            text-decoration: none;
        }


    .account-link:hover {
        background-color: #0FA4AF;
        color: white;
        padding-left: 5px;
        margin-left: -5px;
        border-radius: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        text-decoration: none;
        margin-right: 100px;
    }

    .saveButton {
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 5px 20px 5px 20px;
    }
</style>

