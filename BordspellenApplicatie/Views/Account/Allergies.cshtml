@* @model BordspellenApplicatie.Models.DieetAndAllergiesResponse
 *@
@model BordspellenApplicatie.Domain.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <div class="navigation">
                <p>
                    Homepage / My Account / <b>Allergieen</b>
                </p>
                <h1>
                    My Account
                </h1>
            </div>
            <div class="accountChoises">
                <ul>
                    @Html.ActionLink("My details", "Details", "Account", null, new { @class = "account-link" })
                    <br />
                    @Html.ActionLink("Aangemelde bordspelavonden", "Registered", "Account", null, new { @class = "account-link" })
                    <br />
                    @Html.ActionLink("Georganiseerde bordspelavonden", "Organized", "Account", null, new { @class = "account-link" })
                    <br />
                    @Html.ActionLink("Dieetwensen en allergieen", "Allergies", "Account", null, new { @class = "account-link-selected", @style = "background-color: #0FA4AF; color: white;" })
                    <br />
                    @Html.ActionLink("Account settings", "Settings", "Account", null, new { @class = "account-link"})
                </ul>
            </div>
            <div class="detailsForm">
                <h3 style="margin-top: 20px; margin-bottom: 20px;">Allergieen</h3>
                <form>
                    <div>
                        <label asp-for="IsLactoseIntolerant">Lactose Allergy</label>
                         <input asp-for="IsLactoseIntolerant" type="checkbox" />
                    </div>
                    <div>
                        <label asp-for="HasNutAllergy">Nut Allergy</label>
                        <input asp-for="HasNutAllergy" type="checkbox" />
                    </div>
                    <div>
                        <label asp-for="IsVegetarian">Vegan</label>
                        <input asp-for="IsVegetarian" type="checkbox" />
                    </div>
                    <div>
                        <label asp-for="DrinksAlcohol">Drinks Alcohol</label>
                        <input asp-for="DrinksAlcohol" type="checkbox" />
                    </div>
                    <button class="saveButton" type="submit">Save</button>
                </form>
            </div>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }

    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.5fr 1fr 1fr 0.5fr;
        gap: 10px;
        height: 100vh;
    }

    .navigation {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        padding-left: 50px;
    }

    .accountChoises {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
        padding-left: 50px;
        margin-top: 20px;
    }

    .detailsForm {
        grid-column: 3 / 5;
        grid-row: 3 / 5;
        background-color: #0FA4AF;
        border-radius: 10px;
        margin-left: 50px;
        padding-left: 40px;
        margin-top: 20px;
        margin-right: 50px;
        margin-bottom: 70px;
        color: white;
    }

    .account-link {
        color: black;
        display: block;
    }

    .account-link-selected {
        display: block;
        padding-left: 5px;
        margin-left: -5px;
        border-radius: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        margin-right: 70px;
    }

    .account-link-selected:hover {
        text-decoration: none;
    }

    .account-link:hover {
        background-color: #0FA4AF;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin-left: -5px;
        padding-left: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        margin-right: 70px;
    }

    .saveButton {
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 5px 20px 5px 20px;
    }
</style>

