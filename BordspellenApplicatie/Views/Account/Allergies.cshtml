@model BordspellenApplicatie.Models.DieetAndAllergiesResponse

@{
    Layout = null;
    var bannerUrl = ViewBag.BannerUrl as string;
    var infoText = ViewBag.InfoText as string;
    var futureEvents = ViewBag.FutureEvents as List<BordspellenApplicatie.Models.BoardGameNight>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>

    <!-- Main container with grid layout -->
    <div class="container-fluid">

        <!-- Navbar (spanning columns 1 to 3) -->
        <div class="navbar d-flex justify-content-between align-items-center">
            <a href="/">
                <div class="logo">
                    <img src="/logoBoardgame.jpg" alt="Logo" class="img-fluid" style="max-height: 50px;">
                </div>
            </a>
            <a href="/home/account">
                <img src="/userIcon.png" alt="User Icon" class="img-fluid" style="max-height: 40px;">
            </a>
        </div>
        <div class="navigation">
            <p>
                Homepage / My Account <b>Allergieen</b>
            </p>
            <h1>
                My Account
            </h1>
        </div>
        <div class="accountChoises">
            <ul>
                @Html.ActionLink("My details", "Details", "Account", null, new { @class = "account-link" })
                <br />
                @Html.ActionLink("Aangemelde bordspelavonden", "Registered", "Account", null, new { @class = "account-link" })
                <br />
                @Html.ActionLink("Georganiseerde bordspelavonden", "Organized", "Account", null, new { @class = "account-link" })
                <br />
                @Html.ActionLink("Dieetwensen en allergieen", "Allergies", "Account", null, new { @class = "account-link", @style = "background-color: lightsteelblue" })
                <br />
                @Html.ActionLink("Account settings", "Settings", "Account", null, new { @class = "account-link"})
            </ul>
        </div>
        <div class="detailsForm">
            <h3 style="margin-top: 20px; margin-bottom: 20px;">Allergieen</h3>
            <form>
                <div>
                    <label asp-for="LactoseAllergie">Lactose Allergy</label>
                    <input asp-for="LactoseAllergie" type="checkbox" />
                </div>
                <div>
                    <label asp-for="NutAllergie">Nut Allergy</label>
                    <input asp-for="NutAllergie" type="checkbox" />
                </div>
                <div>
                    <label asp-for="Vegan">Vegan</label>
                    <input asp-for="Vegan" type="checkbox" />
                </div>
                <div>
                    <label asp-for="DrinksAlcohol">Drinks Alcohol</label>
                    <input asp-for="DrinksAlcohol" type="checkbox" />
                </div>
                <button class="saveButton" type="submit">Save</button>
            </form>
        </div>
    </div>

    <!-- Bootstrap and jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    /* Main grid container */
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        background-color: aliceblue;
    }

    /* Navbar spanning columns 1 to 3 */
    .navbar {
        grid-column: 1 / 5; /* Span across the first three columns */
        grid-row: 1 / 2;
        background-color: lightgrey;
        padding: 10px;
        background-color: lightsteelblue;
    }

    .navigation {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        padding-left: 50px;
    }

    .accountChoises {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
        padding-left: 50px;
        margin-top: 20px;
    }

    .detailsForm {
        grid-column: 2 / 4;
        grid-row: 3 / 5;
        background-color: white;
        border-style: solid;
        margin-left: 50px;
        padding-left: 40px;
        margin-top: 20px;
        margin-right: 50px;
    }


    .account-link {
        color: black;
        display: block;
    }

        .account-link:hover {
            background-color: lightsteelblue;
            color: black;
            text-decoration: none;
        }

    .saveButton {
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 5px 20px 5px 20px;
    }
</style>

