@model RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <vc:header></vc:header>
    <div class="container-fluid">
        <div class="title">
            <h1>Create your account</h1>
            <p>Maak een account aan om bordspelavonden te organiseren en je aan te melden voor bordspelavonden</p>
        </div>
        <form class="loginForm" asp-action="Register" method="post">
            <div asp-validation-summary="All">
            </div>
            <div>
            <label asp-for="FirstName">Voornaam</label><br />
            <input asp-for="FirstName" type="text" />
            </div>
            <div style="margin-top: 15px;">
            <label asp-for="LastName">Achternaam</label><br />
            <input asp-for="LastName" type="text" />
            </div>
            <div style="margin-top: 15px;">
            <label asp-for="DateOfBirth">Geboortedatum</label><br />
            <input asp-for="DateOfBirth" type="date" />
            </div>
            <div>
            <select asp-for="Gender">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
            </select>
            </div> 
            <div style="margin-top: 15px;">
                <label asp-for="EmailAddress">Email</label><br />
                <input asp-for="EmailAddress" type="email" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="Password">Wachtwoord</label><br />
                <input asp-for="Password" type="password" />
            </div>
            <div style="margin-top: 15px;">
                <label asp-for="PasswordConfirmation">Wachtwoord Conformatie</label><br />
                <input asp-for="PasswordConfirmation" type="password" />
            </div>
            <div>
            <label asp-for="Address.Street">Street</label><br />
            <input asp-for="Address.Street" type="text" />
            </div>
            <div>
            <label asp-for="Address.Number">Number</label>
            <input asp-for="Address.Number" type="text" />
            </div>
            <div>
            <label asp-for="Address.City">City</label>
            <input asp-for="Address.City" type="text" />
            </div>  
            <div class="allergiesCheckbox">
                <h5>Allergieen</h5>
                <h5></h5>
                <label class="container">
                <input asp-for="IsLactoseIntolerant" type="checkbox">
                Lactose allergie
                <span class="checkmark"></span>
                </label>
                <label class="container">
                <input asp-for="HasNutAllergy" type="checkbox">
                Noten allergie
                <span class="checkmark"></span>
                </label>
                <label class="container">
                <input asp-for="IsVegetarian" type="checkbox">
                Vegetarier
                <span class="checkmark"></span>
                </label>
                <label class="container">
                <input asp-for="DrinksAlcohol" type="checkbox">
                Drinkt geen alcohol
                <span class="checkmark"></span>
                </label>
            </div> 
            <div class="buttonContainer">
                <button class="saveButton" type="submit">Maak account aan</button>
            </div>
        </form>
    </div>
    <vc:footer></vc:footer>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    body {
        background-color: #AFDDE5;
    }

    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.75fr 1fr;
        gap: 10px;
    }

    .title {
        grid-column: 2/3;
        grid-row: 1/2;
        text-align: center;
        margin-top: 30px;
    }

    .loginForm {
        grid-column: 2/3;
        grid-row: 2/3;
        background-color: #0FA4AF;
        padding: 20px;
        margin-bottom: 40px;
        color: white;
    }

    input {
        width: 100%;
        height: 35px;
    }


    .signUp {
        grid-column: 2/3;
        grid-row: 3/4;
        margin-top: 50px;
    }

    .buttonContainer {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-bottom: 50px;
    }

    .saveButton, .signUpButton {
        width: 100%;
        max-width: 200px; 
    }

    .saveButton, .signUpButton {
        padding: 7px 20px;
        font-size: 16px;
        cursor: pointer;
    }


    .allergiesCheckbox {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 10px;
        margin-top: 15px;
    }

        .allergiesCheckbox input[type="checkbox"] {
            width: 16px;
            height: 16px;
            margin-right: 8px;
            vertical-align: middle;
        }

        .allergiesCheckbox .container {
            display: flex;
            align-items: center;
            font-size: 16px;
        }
</style>

