@* @model BordspellenApplicatie.Models.DetailsResponse
 *@
@model BordspellenApplicatie.Domain.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <div class="page-wrapper">
        <vc:header></vc:header>
        <div class="container-fluid content">
            <div class="navigation">
                <p>
                    Homepage / <b>My Account</b>
                </p>
                <h1>
                    My Account
                </h1>
            </div>
            <div class="accountChoises">
                @Html.ActionLink("My details", "Details", "Account", null, new { @class = "account-link-selected", @style = "background-color: #0FA4AF; color: white;" })<br />
                @Html.ActionLink("Aangemelde bordspelavonden", "Registered", "Account", null, new { @class = "account-link" })<br />
                @Html.ActionLink("Georganiseerde bordspelavonden", "Organized", "Account", null, new { @class = "account-link" })<br />
                @Html.ActionLink("Dieetwensen en allergieen", "Allergies", "Account", null, new { @class = "account-link" })<br />
                @Html.ActionLink("Account settings", "Settings", "Account", null, new { @class = "account-link"})

            </div>
            <div class="detailsForm">
                <h3 style="margin-top: 20px; margin-bottom: 20px; color: black;">My Details</h3>
                <form asp-action="UpdateDetails" asp-controller="Account" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="col-md-5">
                            <label class="mt-3" asp-for="FirstName">First name</label><br />
                            <input asp-for="FirstName" type="text" class="form-control" />
                        </div>
                        <div class="col-md-5">
                            <label class="mt-3" asp-for="LastName">Last name</label><br />
                            <input asp-for="LastName" type="text" class="form-control"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <label class="mt-3" asp-for="DateOfBirth">Birthdate</label><br />
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <label class="mt-3" asp-for="Email">Email address</label><br />
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <label class="mt-3" asp-for=Address.Street>Street</label><br />
                            <input asp-for="Address.Street" type="text" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="mt-3" asp-for="Address.Number">Number</label><br />
                            <input asp-for="Address.Number" type="text" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <label class="mt-3" asp-for="Address.City">City</label><br />
                            <input asp-for="Address.City" type="text" class="form-control" />
                        </div>
                    </div>
                    <div asp-validation-summary="All"></div>
                    <button class="saveButton btn" style="background-color:#964734; color:white" type="submit">Save</button>
                </form>
            </div>
        </div>
        <vc:footer></vc:footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        background-color: #AFDDE5;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .content {
        flex: 1;
    }
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 0.5fr 1fr 1fr 0.5fr;
        gap: 10px;
        height: 100vh;
    }

    .navigation {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        padding-left: 50px;
    }

    .accountChoises {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
        padding-left: 50px;
        margin-top: 20px;
    }

    .detailsForm {
        grid-column: 3 / 5;
        grid-row: 3 / 5;
        background-color: #0FA4AF;
        border-radius: 10px;
        margin-left: 50px;
        padding-left: 40px;
        margin-top: 20px;
        margin-right: 50px;
        margin-bottom: 70px;
        color: black;
        font-weight: bold;
    }

    .saveButton {
       margin-top: 20px; 
       margin-bottom: 20px;
       padding: 7px 70px 7px 70px;
       font-size: 16px;
    }

    .name-container {
        display: flex;
        gap: 40px; 
    }

    .addres-container {
        display: flex;
    }

    .account-link {
        color: black;
        display: block;
    }

    .account-link-selected {
        color: black;
        display: block;
        padding-left: 5px;
        margin-left: -5px;
        border-radius: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        margin-right: 100px;
    }

    .account-link:hover {
        background-color: #0FA4AF;
        color: white;
        display: block;
        padding-left: 5px;
        margin-left: -5px;
        border-radius: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        margin-right: 100px;
        text-decoration: none;
    }
</style>

