@* @model BordspellenApplicatie.Models.DetailsResponse
 *@
@model BordspellenApplicatie.Domain.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Game Nights</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    @*     <link rel="stylesheet" href="/css/style.css"/> *@
</head>
<body>
    <div class="container-fluid">
        <div class="navbar d-flex justify-content-between align-items-center">
            <a href="/">
                <div class="logo">
                    <img src="/logoBoardgame.jpg" alt="Logo" class="img-fluid" style="max-height: 50px;">
                </div>
            </a>
            <a href="/home/account">
                <img src="/userIcon.png" alt="User Icon" class="img-fluid" style="max-height: 40px;">
            </a>
        </div>
        <div class="navigation">
            <p>
                Homepage / <b>My Account</b>
            </p>
            <h1>
                My Account
            </h1>
        </div>
        <div class="accountChoises">
            @Html.ActionLink("My details", "Details", "Account", null, new { @class = "account-link", @style = "background-color: lightsteelblue" })<br />
            @Html.ActionLink("Aangemelde bordspelavonden", "Registered", "Account", null, new { @class = "account-link" })<br />
            @Html.ActionLink("Georganiseerde bordspelavonden", "Organized", "Account", null, new { @class = "account-link" })<br />
            @Html.ActionLink("Dieetwensen en allergieen", "Allergies", "Account", null, new { @class = "account-link" })<br />
            @Html.ActionLink("Account settings", "Settings", "Account", null, new { @class = "account-link"})

        </div>
        <div class="detailsForm">
            <h3 style="margin-top: 20px; margin-bottom: 20px;">My Details</h3>
            <form>
                <div class="name-container">
                    <div>
                        <label asp-for="FirstName">First name</label><br />
                        <input asp-for="FirstName" type="text" />
                    </div>
                    <div>
                        <label asp-for="LastName">Last name</label><br />
                        <input asp-for="LastName" type="text"/>
                    </div>
                </div>
                <div>
                    <label asp-for="DateOfBirth">Birthdate</label><br />
                    <input asp-for="DateOfBirth" type="date" />
                </div>
                <div>
                    <label asp-for="Email">Email address</label><br />
                    <input asp-for="Email" type="email"/>
                </div>
                <div>
                    <label asp-for=Address.Street>Street</label><br />
                    <input asp-for="Address.Street" type="text" />
                </div>
                <div>
                    <label asp-for="Address.Number">Number</label><br />
                    <input asp-for="Address.Number" type="text" />
                </div>
                <div>
                    <label asp-for="Address.City">City</label><br />
                    <input asp-for="Address.City" type="text" />
                </div>
                <button class="saveButton" type="submit">Save</button>
            </form>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<style>
    .container-fluid {
        display: grid;
        grid-template-rows: 0.5fr 1fr, 1fr, 1fr;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        height: 100vh;
        background-color: aliceblue;
    }

    .navbar {
        grid-column: 1 / 5; 
        grid-row: 1 / 2;
        background-color: lightsteelblue;
        padding: 10px;
    }

    .navigation {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        padding-left: 50px;
    }

    .accountChoises {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
        padding-left: 50px;
        margin-top: 20px;
    }

    .detailsForm {
        grid-column: 2 / 4;
        grid-row: 3 / 5;
        background-color: white;
        border-style: solid;
        margin-left: 50px;
        padding-left: 40px;
        margin-top: 20px;
        margin-right: 50px;
    }

    .saveButton {
       margin-top: 20px; 
       margin-bottom: 20px;
       padding: 5px 20px 5px 20px;
    }

    .name-container {
        display: flex;
        gap: 40px; 
    }

    .account-link {
        color: black;
        display: block;
    }

    .account-link:hover {
        background-color: lightsteelblue;
        color: black;
        text-decoration: none;
    }
</style>

