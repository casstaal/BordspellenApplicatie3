<div class="navbar d-flex">
    <a href="/">
        <img src="/logoBoardgame.jpg" alt="Logo" class="img-fluid" style="max-height: 50px;">
    </a>
    @Html.ActionLink("Bordspelavonden", "BoardGameNight", "Overview", null, new { @class = "navigation-link" })
    @Html.ActionLink("Aangemeld", "RegisteredBoardGameNights", "Overview", null, new { @class = "navigation-link" })
    @Html.ActionLink("Organiseren", "OrganizedBoardGameNights", "Overview", null, new { @class = "navigation-link" })

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-controller="Account" asp-action="Logout">Logout</a>
        <a asp-controller="Account" asp-action="Details">
            <img src="/userIcon.png" alt="User Icon" class="img-fluid" style="max-height: 40px;">
        </a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="loginButton">Login</a>
        <button onclick="location.href='@Url.Action("Register", "Account")'">Aanmelden</button>
    }
</div>

<style>
         .navbar {
            grid-column: 1 / 5;
            grid-row: 1 / 2;
            background-color: #0FA4AF;
            padding: 10px;
            display: flex;
            align-items: center;
        } 

        .navigation-link {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .navigation-link:hover {
            color: #964734;
        }

        button {
            background-color: #964734;
            color: white;
            padding: 6px;
            border-radius: 4px;
        }

        .loginButton {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }
</style>